# ===== Server =====
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5172

# ===== SQL Server (LocalDB, Windows Authentication) =====
# DB_AUTH=windows  -> user/password ki zarurat nahi (SSMS me jo Windows Authentication use ho raha hai)
# DB_AUTH=sql      -> SQL login (DB_USER / DB_PASSWORD) - hosting par yahi use hota hai
DB_AUTH=windows
DB_SERVER=(localdb)\MSSQLLocalDB
DB_INSTANCE=
DB_PORT=1433
DB_NAME=AliElectronicDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Windows auth ke liye ODBC driver ka naam (check: Win+R -> odbcad32 -> Drivers tab)
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ===== Auth =====
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== First admin (npm run seed:admin) =====
ADMIN_NAME=Ali Admin
ADMIN_EMAIL=admin@alielectronic.com
ADMIN_PASSWORD=Admin@12345

# ===== Stock =====
LOW_STOCK_LIMIT=5
